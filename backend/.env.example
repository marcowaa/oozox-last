# Server Configuration
PORT=5000
NODE_ENV=production
TRUST_PROXY_HOPS=1
API_RATE_LIMIT_MAX=500

# MongoDB Connection (use authenticated connection string in production)
MONGO_ROOT_USER=oozox_root
MONGO_ROOT_PASSWORD=CHANGE_ME_STRONG_MONGO_ROOT_PASSWORD_32_CHARS
MONGO_APP_USER=oozox_app
MONGO_APP_PASSWORD=CHANGE_ME_STRONG_MONGO_APP_PASSWORD_32_CHARS
MONGO_DB_NAME=oozox_prod_db
MONGO_URI=mongodb://oozox_app:CHANGE_ME_STRONG_MONGO_APP_PASSWORD_32_CHARS@mongo:27017/oozox_prod_db?authSource=oozox_prod_db
# For MongoDB Atlas:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/oozox_prod_db?retryWrites=true&w=majority

# AES-256-GCM Database Field-Level Encryption Key (required in production; generate with: openssl rand -hex 32)
DB_ENCRYPTION_KEY=CHANGE_ME_GENERATE_64_HEX_CHARS_DB_ENCRYPTION_KEY

# JWT Security Credentials (MUST match backend-signaling JWT_SECRET, >= 32 random chars)
JWT_SECRET=CHANGE_ME_GENERATE_AT_LEAST_64_HEX_CHARACTERS_WITH_OPENSSL_RAND
JWT_EXPIRES_IN=7d

# CORS Allowed Origins (comma-separated exact HTTPS origins, NEVER '*' in production)
CLIENT_ORIGIN=https://oozox.com,https://www.oozox.com,https://admin.oozox.com
