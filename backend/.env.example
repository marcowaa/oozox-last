# Server Configuration
PORT=5000
NODE_ENV=production
TRUST_PROXY_HOPS=1
API_RATE_LIMIT_MAX=500

# MongoDB Connection (use authenticated connection string in production)
MONGO_ROOT_USER=oozox_root
MONGO_ROOT_PASSWORD=CHANGE_ME_STRONG_MONGO_ROOT_PASSWORD_32_CHARS
MONGO_APP_USER=oozox_app
MONGO_APP_PASSWORD=CHANGE_ME_STRONG_MONGO_APP_PASSWORD_32_CHARS
MONGO_DB_NAME=oozox_prod_db
MONGO_URI=mongodb://oozox_app:CHANGE_ME_STRONG_MONGO_APP_PASSWORD_32_CHARS@mongo:27017/oozox_prod_db?authSource=oozox_prod_db
# For MongoDB Atlas:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/oozox_prod_db?retryWrites=true&w=majority

# AES-256-GCM Database Field-Level Encryption Key (required in production; generate with: openssl rand -hex 32)
DB_ENCRYPTION_KEY=CHANGE_ME_GENERATE_64_HEX_CHARS_DB_ENCRYPTION_KEY

# JWT Security Credentials (MUST match backend-signaling JWT_SECRET, >= 32 random chars)
JWT_SECRET=CHANGE_ME_GENERATE_AT_LEAST_64_HEX_CHARACTERS_WITH_OPENSSL_RAND
JWT_EXPIRES_IN=7d

# CORS Allowed Origins (comma-separated exact HTTPS origins, NEVER '*' in production)
CLIENT_ORIGIN=https://oozox.com,https://www.oozox.com,https://admin.oozox.com

# 30-Day Server Device Trust & Session Rotation
DEVICE_TRUST_DAYS=30
REFRESH_TOKEN_DAYS=30
PRE_AUTH_EXPIRES_IN=15m
SENSITIVE_STEP_UP_SECONDS=900

# OTP Channels: Telegram Gateway (no Bot) -> Twilio Verify (WhatsApp / SMS)
TELEGRAM_GATEWAY_TOKEN=CHANGE_ME_TELEGRAM_GATEWAY_API_TOKEN
TELEGRAM_GATEWAY_BASE_URL=https://gatewayapi.telegram.org
TELEGRAM_GATEWAY_CALLBACK_URL=https://api.oozox.com/api/auth/webhooks/telegram-gateway
TELEGRAM_GATEWAY_COST_USD=0.01

TWILIO_ACCOUNT_SID=AC_CHANGE_ME_TWILIO_ACCOUNT_SID
TWILIO_AUTH_TOKEN=CHANGE_ME_TWILIO_AUTH_TOKEN
TWILIO_VERIFY_SERVICE_SID=VA_CHANGE_ME_TWILIO_VERIFY_SERVICE_SID
TWILIO_WHATSAPP_COST_USD=0.055
TWILIO_SMS_COST_USD=0.07

# OTP Anti-Abuse & Budget Guardrails
OTP_CHANNEL_ORDER=TELEGRAM,WHATSAPP,SMS
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_DAILY_MAX_PER_PHONE=5
OTP_MAX_ATTEMPTS=5
OTP_LOCK_MINUTES=15
OTP_MONTHLY_BUDGET_USD=100
OTP_ALLOWED_COUNTRIES=+20,+966,+971,+965,+974,+973,+968,+962,+961,+964,+212,+216,+213,+1,+44,+49,+90
